{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studio",
  "mainBinaryName": "studio-app",
  "version": "0.1.0",
  "identifier": "com.athanor.studio",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "public.app-category.video",
    "shortDescription": "Raw footage in; a finished vertical video and post drafts out",
    "copyright": "athanor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
