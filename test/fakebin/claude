#!/usr/bin/env python3
# Fake `claude -p --output-format json ...` (the claude adapter's surface): the prompt on stdin,
# canned moments / drafts back, no subscription spent.
import json, os, sys, time
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "fakeagents"))
import canned
if sys.argv[1:3] != ["-p", "--output-format"]:
    sys.exit(f"fake claude: unexpected args {sys.argv[1:]}")
p = sys.stdin.read()
canned.record(sys.argv, p)
time.sleep(float(os.environ.get("FAKE_AGENT_DELAY", "2")))
print(json.dumps({"result": canned.reply(p), "is_error": False}))
